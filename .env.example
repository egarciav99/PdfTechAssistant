# Frontend (Vite). También se pueden poner en public/config.json sin recompilar.
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
# Opcionales
VITE_DEFAULT_LANGUAGE=es
VITE_COMPANY_NAME=
VITE_LOGO_URL=

# Los secretos de las Edge Functions (GEMINI_API_KEY, PDF_APP_URL, PDF_ALLOWED_ORIGINS)
# se configuran con `npx supabase secrets set`, nunca aquí. Ver docs/ENTREGA.md.
